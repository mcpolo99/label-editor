<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LabelEditor.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <StreamGeometry x:Key="IconAlignLeft">M1,1 H2.5 V15 H1 Z M4,3 H14 V6.5 H4 Z M4,9.5 H10 V13 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconAlignRight">M13.5,1 H15 V15 H13.5 Z M2,3 H12 V6.5 H2 Z M6,9.5 H12 V13 H6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconAlignTop">M1,1 H15 V2.5 H1 Z M3,4 H6.5 V14 H3 Z M9.5,4 H13 V10 H9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconAlignBottom">M1,13.5 H15 V15 H1 Z M3,2 H6.5 V12 H3 Z M9.5,6 H13 V12 H9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconCenterH">M7.25,1 H8.75 V2.5 H7.25 Z M7.25,7 H8.75 V9 H7.25 Z M7.25,13.5 H8.75 V15 H7.25 Z M2,3 H14 V6.5 H2 Z M4.5,9.5 H11.5 V13 H4.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconCenterV">M1,7.25 V8.75 H2.5 V7.25 Z M7,7.25 V8.75 H9 V7.25 Z M13.5,7.25 V8.75 H15 V7.25 Z M3,2 H6.5 V14 H3 Z M9.5,4.5 H13 V11.5 H9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSameWidth">M2,2 H14 V5.5 H2 Z M2,8 H14 V11.5 H2 Z M1,13.5 H15 V15 H1 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSameHeight">M2,2 H5.5 V14 H2 Z M8,2 H11.5 V14 H8 Z M13.5,1 H15 V15 H13.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSameSize">M1.5,1.5 H7 V7 H1.5 Z M9,1.5 H14.5 V7 H9 Z M5.25,9 H10.75 V14.5 H5.25 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSpaceAcross">M1,4 H3.5 V12 H1 Z M6.75,4 H9.25 V12 H6.75 Z M12.5,4 H15 V12 H12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSpaceDown">M4,1 H12 V3.5 H4 Z M4,6.75 H12 V9.25 H4 Z M4,12.5 H12 V15 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSnapGrid">M1,1 H3 V3 H1 Z M7,1 H9 V3 H7 Z M13,1 H15 V3 H13 Z M1,7 H3 V9 H1 Z M13,7 H15 V9 H13 Z M1,13 H3 V15 H1 Z M7,13 H9 V15 H7 Z M13,13 H15 V15 H13 Z M5,5 H11 V11 H5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconFront">M1,1 H10 V4.5 H4.5 V10 H1 Z M5.5,5.5 H15 V15 H5.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconBack">M1,1 H10 V10 H1 Z M11,5.5 H15 V15 H5.5 V11 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="IconLock">M3.5,7 H12.5 V15 H3.5 Z M5,7 V5 A3,3 0 0 1 11,5 V7 H9.5 V5 A1.5,1.5 0 0 0 6.5,5 V7 Z</StreamGeometry>
    <StreamGeometry x:Key="IconUndo">M6,2 L1,6 L6,10 V7.5 H10 A3,3 0 0 1 10,13.5 H5 V15 H10 A4.5,4.5 0 0 0 10,6 H6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconRedo">M10,2 L15,6 L10,10 V7.5 H6 A3,3 0 0 0 6,13.5 H11 V15 H6 A4.5,4.5 0 0 1 6,6 H10 Z</StreamGeometry>
    <StreamGeometry x:Key="IconDelete">M5,1 H11 V2.5 H14 V4 H2 V2.5 H5 Z M3.5,5 H12.5 L11.5,15 H4.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconDuplicate">M1,1 H10 V3 H3 V10 H1 Z M5,5 H15 V15 H5 Z</StreamGeometry>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#666" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinWidth" Value="90" />
    </Style>
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button.icon:disabled PathIcon">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.tool, ToggleButton.tool, RadioButton.tool">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
  </Application.Styles>
</Application>
