<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabelEditor.Presentation.ViewModels"
        xmlns:props="using:LabelEditor.Presentation.ViewModels.Properties"
        xmlns:ports="using:LabelEditor.Application.Abstractions"
        xmlns:preview="using:LabelEditor.Application.Preview"
        xmlns:loc="using:LabelEditor.Application.Localization"
        xmlns:controls="using:LabelEditor.App.Controls"
        xmlns:views="using:LabelEditor.App.Views"
        x:Class="LabelEditor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Label Editor"
        Icon="/Assets/app.ico"
        Width="1400" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomActualSizeCommand}" />
    <KeyBinding Gesture="PageDown" Command="{Binding NextRecordCommand}" />
    <KeyBinding Gesture="PageUp" Command="{Binding PreviousRecordCommand}" />
  </Window.KeyBindings>

  <!-- Property panels, chosen by the type of the active document's Properties view model. -->
  <Window.DataTemplates>
    <controls:FreshDataTemplate DataType="props:LabelSettingsViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="Label" />
        <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="4">
          <TextBlock Classes="label" Text="Width / Height" />
          <NumericUpDown Grid.Column="1" Value="{Binding LabelWidth}" Increment="1" Minimum="1" FormatString="0.###" />
          <NumericUpDown Grid.Column="2" Value="{Binding LabelHeight}" Increment="1" Minimum="1" FormatString="0.###" />
          <TextBlock Grid.Row="1" Classes="label" Text="Grid" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GridSize}" Increment="0.5" Minimum="0" FormatString="0.###" />
          <TextBlock Grid.Row="2" Classes="label" Text="Unit" />
          <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Format" />
          <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="{Binding FormatVersion, StringFormat='LEdit {0}'}" />
        </Grid>
        <TextBlock Classes="hint" Text="{Binding EntryCount, StringFormat='{}{0} entries. Select an entry to edit it; drag fields from the Fields tab onto the label.'}" />
      </StackPanel>
    </controls:FreshDataTemplate>

    <controls:FreshDataTemplate DataType="props:MultiSelectionViewModel">
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="{Binding Title}" />
        <TextBlock Classes="hint" Text="{Binding Hint}" />
      </StackPanel>
    </controls:FreshDataTemplate>

    <controls:FreshDataTemplate DataType="props:TextPropertiesViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="{Binding Title}" />
        <views:GeometryEditor />
        <TextBlock Classes="section" Text="Content" />
        <Border BorderBrush="{DynamicResource BoxBorder}" BorderThickness="1" Padding="6,4" Background="{DynamicResource BoxBackground}">
          <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontFamily="Consolas,monospace" />
        </Border>
        <!-- Composer: the entry prints its pieces in this order. Click a chip to edit it; new pieces go after it. -->
        <ItemsControl ItemsSource="{Binding Elements}" Margin="0,4,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <controls:FreshDataTemplate DataType="props:TextElementViewModel">
              <Border Classes="chip" Classes.literal="{Binding IsLiteral}" Classes.selected="{Binding IsSelected}">
                <StackPanel Orientation="Horizontal">
                  <Button Classes="chipbody" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding FieldCaption}">
                    <TextBlock Text="{Binding Display}" />
                  </Button>
                  <Button Classes="chipremove" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this piece" />
                </StackPanel>
              </Border>
            </controls:FreshDataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="hint" Text="Empty: use + Field… to add data fields or Raw text." IsVisible="{Binding !Elements.Count}" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="+ Field…" Command="{Binding AddFieldsCommand}" ToolTip.Tip="Add data fields, or Raw text for fixed text such as &quot;L: &quot; or &quot; / &quot;, after the selected piece (Ctrl+click for several)" />
          <Button Content="◀" Command="{Binding MoveElementUpCommand}" ToolTip.Tip="Move the selected piece left" />
          <Button Content="▶" Command="{Binding MoveElementDownCommand}" ToolTip.Tip="Move the selected piece right" />
        </StackPanel>
        <ContentControl Content="{Binding SelectedElement}">
          <ContentControl.ContentTemplate>
            <controls:FreshDataTemplate DataType="props:TextElementViewModel">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="4" Margin="0,4,0,0">
                <TextBlock Classes="label" Text="Prints" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                  <!-- One-way + commands: re-binding on selection changes must never switch the kind or open a dialog. -->
                  <RadioButton Content="Data field" IsChecked="{Binding IsField, Mode=OneWay}" Command="{Binding UseDataFieldCommand}" />
                  <RadioButton Content="Fixed text" IsChecked="{Binding IsLiteral, Mode=OneWay}" Command="{Binding UseFixedTextCommand}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="label" Text="Text" IsVisible="{Binding IsLiteral}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LiteralText}" IsVisible="{Binding IsLiteral}" />
                <TextBlock Grid.Row="1" Classes="label" Text="Field" IsVisible="{Binding IsField}" />
                <!-- Fields are chosen from the structured field tree (dialog), never typed. -->
                <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsField}">
                  <Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseFieldCommand}" Margin="4,0,0,0" />
                  <Border BorderBrush="{DynamicResource BoxBorder}" BorderThickness="1" CornerRadius="3" Padding="6,4" Background="{DynamicResource BoxBackground}" ToolTip.Tip="{Binding FieldCaption}">
                    <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </Border>
                </DockPanel>
                <TextBlock Grid.Row="2" Classes="label" Text="ID" IsVisible="{Binding IsField}" />
                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding IsField}" Foreground="{DynamicResource MutedForeground}" Text="{Binding FieldId}" ToolTip.Tip="{Binding FieldCaption}" />
                <TextBlock Grid.Row="3" Classes="label" Text="Sample value" IsVisible="{Binding IsField}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PreviewText}" Watermark="shown while designing" IsVisible="{Binding IsField}" />
                <TextBlock Grid.Row="4" Classes="label" Text="Skip first / last" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <NumericUpDown Value="{Binding DeleteFirst}" Minimum="0" Increment="1" FormatString="0" />
                  <NumericUpDown Value="{Binding DeleteLast}" Minimum="0" Increment="1" FormatString="0" />
                </StackPanel>
                <TextBlock Grid.Row="5" Classes="label" Text="Characters" />
                <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Count}" Minimum="-1" Increment="1" FormatString="0" ToolTip.Tip="-1 = all" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="6" Classes="label" Text="Fill" />
                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding FillModes}" SelectedItem="{Binding FillMode}" HorizontalAlignment="Stretch" />
              </Grid>
            </controls:FreshDataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <TextBlock Classes="section" Text="Font" />
        <AutoCompleteBox Text="{Binding FontFamily}" ItemsSource="{Binding FontFamilies}" FilterMode="ContainsOrdinal" Watermark="Font" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="4">
          <TextBlock Classes="label" Text="Size (pt)" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <NumericUpDown Value="{Binding FontSize}" Minimum="1" Increment="0.5" FormatString="0.#" IsEnabled="{Binding FontSizeFixed}" />
            <CheckBox Content="Fixed" IsChecked="{Binding FontSizeFixed}" ToolTip.Tip="Off: the text is scaled to fill its field" />
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="label" Text="Direction" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Rotations}" SelectedItem="{Binding Rotation}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <controls:FreshDataTemplate DataType="props:RotationOption">
                <TextBlock Text="{Binding Name}" />
              </controls:FreshDataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <WrapPanel>
          <ToggleButton Classes="tool" IsChecked="{Binding Bold}" FontWeight="Bold" Content="B" ToolTip.Tip="Bold" Margin="0,0,4,4" />
          <ToggleButton Classes="tool" IsChecked="{Binding Italic}" FontStyle="Italic" Content="I" ToolTip.Tip="Italic" Margin="0,0,4,4" />
          <ToggleButton Classes="tool" IsChecked="{Binding Underline}" Content="U" ToolTip.Tip="Underline" Margin="0,0,4,4" />
          <ToggleButton Classes="tool" IsChecked="{Binding StrikeOut}" Content="S" ToolTip.Tip="Strike-out" Margin="0,0,12,4" />
          <CheckBox Content="Upper case" IsChecked="{Binding UpperCase}" Margin="0,0,8,0" />
          <CheckBox Content="Word wrap" IsChecked="{Binding WordWrap}" />
        </WrapPanel>

        <TextBlock Classes="section" Text="Bar code" />
        <CheckBox Content="Print as bar code" IsChecked="{Binding IsBarcode}" />
        <ComboBox ItemsSource="{Binding BarcodeTypes}" SelectedItem="{Binding BarcodeType}" IsVisible="{Binding IsBarcode}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <controls:FreshDataTemplate DataType="props:BarcodeTypeOption">
              <TextBlock Text="{Binding Name}" />
            </controls:FreshDataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </controls:FreshDataTemplate>

    <controls:FreshDataTemplate DataType="props:EllipsePropertiesViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="{Binding Title}" />
        <views:GeometryEditor />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="4" Margin="0,6,0,0">
          <TextBlock Classes="label" Text="Pen width" />
          <NumericUpDown Grid.Column="1" Value="{Binding PenWidth}" Minimum="0" Increment="1" FormatString="0" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Classes="label" Text="Line colour" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PenColor}" Watermark="r,g,b" />
          <TextBlock Grid.Row="2" Classes="label" Text="Fill colour" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BrushColor}" Watermark="r,g,b" />
        </Grid>
      </StackPanel>
    </controls:FreshDataTemplate>

    <controls:FreshDataTemplate DataType="props:LinePropertiesViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="{Binding Title}" />
        <views:GeometryEditor />
        <TextBlock Classes="hint" Text="Drag either end point to change the line. Hold Shift while drawing for horizontal/vertical lines." />
      </StackPanel>
    </controls:FreshDataTemplate>

    <controls:FreshDataTemplate DataType="props:BitmapPropertiesViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="{Binding Title}" />
        <views:GeometryEditor />
        <TextBlock Classes="label" Text="File" Margin="0,6,0,0" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseCommand}" Margin="4,0,0,0" />
          <TextBox Text="{Binding Path}" />
        </DockPanel>
        <TextBlock Classes="hint" Text="File not found on this computer. LEdit stores absolute paths; the printing machine must have the file at this path." IsVisible="{Binding !FileExists}" Foreground="DarkOrange" />
      </StackPanel>
    </controls:FreshDataTemplate>

    <controls:FreshDataTemplate DataType="props:LabelGraphicPropertiesViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="{Binding Title}" />
        <views:GeometryEditor />
        <TextBlock Classes="label" Text="Part graphic" Margin="0,6,0,0" />
        <ComboBox ItemsSource="{Binding Slots}" SelectedIndex="{Binding GraphicIndex}" HorizontalAlignment="Stretch" />
        <TextBlock Classes="hint" Text="Filled at print time with the part's drawing from the optimised parts list." />
      </StackPanel>
    </controls:FreshDataTemplate>

    <controls:FreshDataTemplate DataType="props:CornerLogoPropertiesViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="{Binding Title}" />
        <views:GeometryEditor />
        <TextBlock Classes="hint" Text="{Binding Hint}" />
        <CheckBox Content="Maintain aspect ratio" IsChecked="{Binding KeepAspectRatio}" Margin="0,6,0,0" ToolTip.Tip="Draw the part with its real length / width proportions" />
        <CheckBox Content="Print edge information" IsChecked="{Binding PrintEdgeMaterial}" ToolTip.Tip="Print the edge texts next to the sides; off = banding only" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="4">
          <TextBlock Classes="label" Text="Edge info" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding EdgeInfoOptions}" SelectedIndex="{Binding EdgeInfo}" HorizontalAlignment="Stretch" ToolTip.Tip="Which edge data each side prints: material, colour or type" />
          <TextBlock Grid.Row="1" Classes="label" Text="Edge thickness %" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding EdgeThicknessPercent}" Minimum="0" Maximum="50" FormatString="0" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="2" Classes="label" Text="Orientation" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Orientation}" Minimum="0" Increment="1" FormatString="0" HorizontalAlignment="Left"
                         ToolTip.Tip="LEdit's 'Orient' value, kept as it is. Empty for labels from older LEdit versions." />
          <TextBlock Grid.Row="3" Classes="label" Text="Top" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TextTop}" Watermark="{Binding TopField, StringFormat='no edge · prints {0}'}" ToolTip.Tip="{Binding TopField, StringFormat='Edge A top. Printed from the part data {0}'}" />
          <TextBlock Grid.Row="4" Classes="label" Text="Bottom" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TextBottom}" Watermark="{Binding BottomField, StringFormat='no edge · prints {0}'}" ToolTip.Tip="{Binding BottomField, StringFormat='Edge A bottom. Printed from the part data {0}'}" />
          <TextBlock Grid.Row="5" Classes="label" Text="Left" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TextLeft}" Watermark="{Binding LeftField, StringFormat='no edge · prints {0}'}" ToolTip.Tip="{Binding LeftField, StringFormat='Edge B left. Printed from the part data {0}'}" />
          <TextBlock Grid.Row="6" Classes="label" Text="Right" />
          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TextRight}" Watermark="{Binding RightField, StringFormat='no edge · prints {0}'}" ToolTip.Tip="{Binding RightField, StringFormat='Edge B right. Printed from the part data {0}'}" />
        </Grid>
      </StackPanel>
    </controls:FreshDataTemplate>

    <controls:FreshDataTemplate DataType="props:UnknownEntryPropertiesViewModel">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="{Binding Title}" />
        <views:GeometryEditor />
        <TextBlock Classes="hint" Text="{Binding Hint}" />
      </StackPanel>
    </controls:FreshDataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
        <MenuItem Header="_Close" Command="{Binding CloseDocumentCommand}" InputGesture="Ctrl+W" />
        <Separator />
        <MenuItem Header="_History…" Command="{Binding ShowHistoryCommand}" />
        <Separator />
        <MenuItem Header="Load _preview data…" Command="{Binding LoadPreviewDataCommand}" />
        <MenuItem Header="Clear preview data" Command="{Binding ClearPreviewDataCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoHeader}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="{Binding RedoHeader}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
        <MenuItem Header="_Duplicate" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D" />
        <MenuItem Header="De_lete" Command="{Binding DeleteCommand}" InputGesture="Delete" />
        <Separator />
        <MenuItem Header="Select _all" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
      </MenuItem>
      <MenuItem Header="_Arrange">
        <MenuItem Header="Align _left" Command="{Binding ArrangeCommand}" CommandParameter="AlignLeft" />
        <MenuItem Header="Align _right" Command="{Binding ArrangeCommand}" CommandParameter="AlignRight" />
        <MenuItem Header="Align _top" Command="{Binding ArrangeCommand}" CommandParameter="AlignTop" />
        <MenuItem Header="Align _bottom" Command="{Binding ArrangeCommand}" CommandParameter="AlignBottom" />
        <Separator />
        <MenuItem Header="Center _horizontally in label" Command="{Binding ArrangeCommand}" CommandParameter="CenterH" />
        <MenuItem Header="Center _vertically in label" Command="{Binding ArrangeCommand}" CommandParameter="CenterV" />
        <Separator />
        <MenuItem Header="Same _width" Command="{Binding ArrangeCommand}" CommandParameter="SameWidth" />
        <MenuItem Header="Same h_eight" Command="{Binding ArrangeCommand}" CommandParameter="SameHeight" />
        <MenuItem Header="Same si_ze" Command="{Binding ArrangeCommand}" CommandParameter="SameSize" />
        <Separator />
        <MenuItem Header="Space _across" Command="{Binding ArrangeCommand}" CommandParameter="SpaceAcross" />
        <MenuItem Header="Space _down" Command="{Binding ArrangeCommand}" CommandParameter="SpaceDown" />
        <Separator />
        <MenuItem Header="_Snap to grid" Command="{Binding ArrangeCommand}" CommandParameter="SnapToGrid" />
        <MenuItem Header="Bring to _front" Command="{Binding ArrangeCommand}" CommandParameter="Front" />
        <MenuItem Header="Send to bac_k" Command="{Binding ArrangeCommand}" CommandParameter="Back" />
        <Separator />
        <MenuItem Header="_Lock size" Command="{Binding ArrangeCommand}" CommandParameter="LockSize" />
        <MenuItem Header="_Unlock size" Command="{Binding ArrangeCommand}" CommandParameter="UnlockSize" />
        <MenuItem Header="Lock _position" Command="{Binding ArrangeCommand}" CommandParameter="LockPosition" />
        <MenuItem Header="Unlock p_osition" Command="{Binding ArrangeCommand}" CommandParameter="UnlockPosition" />
      </MenuItem>
      <MenuItem Header="_Help" Classes="help">
        <MenuItem Header="_About Label Editor" Command="{Binding AboutCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Zoom _in" Command="{Binding ZoomInCommand}" InputGesture="Ctrl+OemPlus" />
        <MenuItem Header="Zoom _out" Command="{Binding ZoomOutCommand}" InputGesture="Ctrl+OemMinus" />
        <MenuItem Header="_Actual size" Command="{Binding ZoomActualSizeCommand}" InputGesture="Ctrl+D0" />
        <Separator />
        <MenuItem Header="Show _grid" ToggleType="CheckBox" IsChecked="{Binding Context.ShowGrid}" />
        <MenuItem Header="_Snap to grid" ToggleType="CheckBox" IsChecked="{Binding Context.SnapToGrid}" />
        <Separator />
        <MenuItem Header="_Theme">
          <MenuItem Header="_System (follow Windows)" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsSystemTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="System" />
          <MenuItem Header="_Light" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsLightTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
          <MenuItem Header="_Dark" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsDarkTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
          <Separator />
          <MenuItem Header="Dim _label paper in dark theme" ToggleType="CheckBox" IsChecked="{Binding Context.DimLabelInDarkTheme}" />
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BarBorder}" BorderThickness="0,0,0,1" Padding="6,4" Background="{DynamicResource ToolbarBackground}">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="tool" Content="New" Command="{Binding NewDocumentCommand}" />
          <Button Classes="tool" Content="Open" Command="{Binding OpenCommand}" />
          <Button Classes="tool" Content="Save" Command="{Binding SaveCommand}" />
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,2" />
          <ItemsControl ItemsSource="{Binding Tools}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ToolOption">
                <ToggleButton Classes="tool" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Name}" MinWidth="32">
                  <TextBlock Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center" />
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,2" />
          <Button Classes="tool" Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (Ctrl+wheel)" />
          <TextBlock VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" Text="{Binding ActiveDocument.Zoom, StringFormat='{}{0:P0}', FallbackValue=''}" />
          <Button Classes="tool" Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (Ctrl+wheel)" />
          <CheckBox Content="Grid" IsChecked="{Binding Context.ShowGrid}" Margin="8,0,0,0" />
          <CheckBox Content="Snap" IsChecked="{Binding Context.SnapToGrid}" ToolTip.Tip="Snap to grid (hold Alt to move freely)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
          <TextBlock VerticalAlignment="Center" Text="Preview:" />
          <Button Classes="tool" Content="◀" Command="{Binding PreviousRecordCommand}" ToolTip.Tip="Previous record (PageUp)" />
          <ComboBox MinWidth="140" ItemsSource="{Binding PreviewRecords}" SelectedItem="{Binding SelectedPreviewRecord}" PlaceholderText="design view">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="preview:PreviewRecord">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="tool" Content="▶" Command="{Binding NextRecordCommand}" ToolTip.Tip="Next record (PageDown)" />
          <Button Classes="tool" Content="Load data…" Command="{Binding LoadPreviewDataCommand}" ToolTip.Tip="Fill the label with values from a label sheet (*_lbl.xml)" />
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,2" />
          <TextBlock VerticalAlignment="Center" Text="Language:" />
          <ComboBox MinWidth="110" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="loc:LanguageInfo">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Edit / arrange toolbar. Buttons are enabled only when the selection allows the command. -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BarBorder}" BorderThickness="0,0,0,1" Padding="6,2" Background="{DynamicResource SubToolbarBackground}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="1">
          <Button Classes="icon" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)"><PathIcon Data="{StaticResource IconUndo}" /></Button>
          <Button Classes="icon" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)"><PathIcon Data="{StaticResource IconRedo}" /></Button>
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,3" />
          <Button Classes="icon" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate (Ctrl+D)"><PathIcon Data="{StaticResource IconDuplicate}" /></Button>
          <Button Classes="icon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete (Del)"><PathIcon Data="{StaticResource IconDelete}" /></Button>
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,3" />
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="AlignLeft" ToolTip.Tip="Align left edges to the first selected entry"><PathIcon Data="{StaticResource IconAlignLeft}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="AlignRight" ToolTip.Tip="Align right edges to the first selected entry"><PathIcon Data="{StaticResource IconAlignRight}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="AlignTop" ToolTip.Tip="Align top edges to the first selected entry"><PathIcon Data="{StaticResource IconAlignTop}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="AlignBottom" ToolTip.Tip="Align bottom edges to the first selected entry"><PathIcon Data="{StaticResource IconAlignBottom}" /></Button>
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,3" />
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="CenterH" ToolTip.Tip="Center horizontally in the label"><PathIcon Data="{StaticResource IconCenterH}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="CenterV" ToolTip.Tip="Center vertically in the label"><PathIcon Data="{StaticResource IconCenterV}" /></Button>
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,3" />
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="SameWidth" ToolTip.Tip="Make same width as the first selected entry (along each entry's text direction)"><PathIcon Data="{StaticResource IconSameWidth}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="SameHeight" ToolTip.Tip="Make same height as the first selected entry (across each entry's text direction)"><PathIcon Data="{StaticResource IconSameHeight}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="SameSize" ToolTip.Tip="Make same size as the first selected entry"><PathIcon Data="{StaticResource IconSameSize}" /></Button>
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,3" />
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="SpaceAcross" ToolTip.Tip="Space evenly across (3 or more entries)"><PathIcon Data="{StaticResource IconSpaceAcross}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="SpaceDown" ToolTip.Tip="Space evenly down (3 or more entries)"><PathIcon Data="{StaticResource IconSpaceDown}" /></Button>
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,3" />
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="SnapToGrid" ToolTip.Tip="Snap position to grid"><PathIcon Data="{StaticResource IconSnapGrid}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="Front" ToolTip.Tip="Bring to front"><PathIcon Data="{StaticResource IconFront}" /></Button>
          <Button Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="Back" ToolTip.Tip="Send to back"><PathIcon Data="{StaticResource IconBack}" /></Button>
          <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="4,3" />
          <ToggleButton Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="ToggleLock" IsChecked="{Binding IsSelectionSizeLocked, Mode=OneWay}" ToolTip.Tip="Lock size: move freely without changing width and height"><PathIcon Data="{StaticResource IconLock}" /></ToggleButton>
          <ToggleButton Classes="icon" Command="{Binding ArrangeCommand}" CommandParameter="TogglePositionLock" IsChecked="{Binding IsSelectionPositionLocked, Mode=OneWay}" ToolTip.Tip="Lock position: keep X / Y; still resizable from the right and bottom"><PathIcon Data="{StaticResource IconPin}" /></ToggleButton>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BarBorder}" BorderThickness="0,1,0,0" Padding="8,3" Background="{DynamicResource ToolbarBackground}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveDocument.CursorPosition, FallbackValue=''}" MinWidth="120" TextAlignment="Right" />
        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" Margin="8,0" />
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="280,4,*,4,330">
      <!-- Left: fields, labels, data -->
      <TabControl Grid.Column="0" Padding="4">
        <TabItem Header="Fields">
          <DockPanel>
            <TextBox DockPanel.Dock="Top" Text="{Binding FieldPicker.Filter}" Watermark="Filter (name, caption or ID)" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,4,0,0" Text="Drag a field onto the label, or double-click to add it to the selected text." />
            <TreeView x:Name="FieldTree" ItemsSource="{Binding FieldPicker.Nodes}" SelectedItem="{Binding FieldPicker.SelectedNode}" DoubleTapped="OnFieldDoubleTapped">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:FieldNodeViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:FieldNodeViewModel" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding ToolTip}" Background="Transparent"
                              PointerPressed="OnFieldPointerPressed" PointerMoved="OnFieldPointerMoved">
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding IsField, Converter={x:Static views:MainWindow.FieldWeight}}" />
                    <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource MutedForeground}" IsVisible="{Binding IsField}" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </TabItem>
        <TabItem Header="Labels">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4">
              <TextBlock Classes="hint" Text="{Binding DataSourceDescription}" />
              <Button Content="Refresh" Command="{Binding Library.RefreshCommand}" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Library.Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:LabelLibraryGroup">
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Classes="section" Text="{Binding Title}" ToolTip.Tip="{Binding Folder}" />
                      <ListBox ItemsSource="{Binding Items}" DoubleTapped="OnLibraryDoubleTapped">
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="ports:LabelLibraryItem">
                            <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Path}" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Data">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4">
              <TextBlock Classes="hint" Text="Load a label sheet (*_lbl.xml) to preview labels with real part data. Values bind to fields by name." />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Load…" Command="{Binding LoadPreviewDataCommand}" />
                <Button Content="Clear" Command="{Binding ClearPreviewDataCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding PreviewDataDescription}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </StackPanel>
            <ListBox ItemsSource="{Binding PreviewRecords}" SelectedItem="{Binding SelectedPreviewRecord}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="preview:PreviewRecord">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SplitterBrush}" />

      <!-- Centre: open documents -->
      <TabControl Grid.Column="2" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}" Padding="0">
        <TabControl.ItemTemplate>
          <DataTemplate DataType="vm:DocumentViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding ToolTip}">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <Button Content="✕" Padding="4,0" FontSize="10" Background="Transparent" Click="OnCloseTabClick" Tag="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate DataType="vm:DocumentViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource DeskBrush}">
              <controls:LabelCanvas Document="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <controls:LabelCanvas.ContextMenu>
                  <ContextMenu>
                  <MenuItem Header="Select _overlapping" Tag="pick-overlapping" IsVisible="False" ToolTip.Tip="All entries under the pointer, topmost first (also: Alt+click)" />
                  <Separator Tag="pick-overlapping" IsVisible="False" />
                  <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
                  <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
                  <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                  <MenuItem Header="_Duplicate" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D"><MenuItem.Icon><PathIcon Data="{StaticResource IconDuplicate}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  <MenuItem Header="De_lete" Command="{Binding DeleteCommand}" InputGesture="Delete"><MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  <Separator />
                  <MenuItem Header="_Align">
                    <MenuItem Header="_Left" Command="{Binding ArrangeCommand}" CommandParameter="AlignLeft"><MenuItem.Icon><PathIcon Data="{StaticResource IconAlignLeft}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Right" Command="{Binding ArrangeCommand}" CommandParameter="AlignRight"><MenuItem.Icon><PathIcon Data="{StaticResource IconAlignRight}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Top" Command="{Binding ArrangeCommand}" CommandParameter="AlignTop"><MenuItem.Icon><PathIcon Data="{StaticResource IconAlignTop}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Bottom" Command="{Binding ArrangeCommand}" CommandParameter="AlignBottom"><MenuItem.Icon><PathIcon Data="{StaticResource IconAlignBottom}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  </MenuItem>
                  <MenuItem Header="Center in _label">
                    <MenuItem Header="_Horizontally" Command="{Binding ArrangeCommand}" CommandParameter="CenterH"><MenuItem.Icon><PathIcon Data="{StaticResource IconCenterH}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Vertically" Command="{Binding ArrangeCommand}" CommandParameter="CenterV"><MenuItem.Icon><PathIcon Data="{StaticResource IconCenterV}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  </MenuItem>
                  <MenuItem Header="Make same _size">
                    <MenuItem Header="_Width" Command="{Binding ArrangeCommand}" CommandParameter="SameWidth"><MenuItem.Icon><PathIcon Data="{StaticResource IconSameWidth}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Height" Command="{Binding ArrangeCommand}" CommandParameter="SameHeight"><MenuItem.Icon><PathIcon Data="{StaticResource IconSameHeight}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Both" Command="{Binding ArrangeCommand}" CommandParameter="SameSize"><MenuItem.Icon><PathIcon Data="{StaticResource IconSameSize}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  </MenuItem>
                  <MenuItem Header="Space _evenly">
                    <MenuItem Header="_Across" Command="{Binding ArrangeCommand}" CommandParameter="SpaceAcross"><MenuItem.Icon><PathIcon Data="{StaticResource IconSpaceAcross}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Down" Command="{Binding ArrangeCommand}" CommandParameter="SpaceDown"><MenuItem.Icon><PathIcon Data="{StaticResource IconSpaceDown}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  </MenuItem>
                  <MenuItem Header="Snap to _grid" Command="{Binding ArrangeCommand}" CommandParameter="SnapToGrid"><MenuItem.Icon><PathIcon Data="{StaticResource IconSnapGrid}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  <Separator />
                  <MenuItem Header="Bring to _front" Command="{Binding ArrangeCommand}" CommandParameter="Front"><MenuItem.Icon><PathIcon Data="{StaticResource IconFront}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Send to bac_k" Command="{Binding ArrangeCommand}" CommandParameter="Back"><MenuItem.Icon><PathIcon Data="{StaticResource IconBack}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  <Separator />
                  <MenuItem Header="L_ock size" Command="{Binding ArrangeCommand}" CommandParameter="LockSize"><MenuItem.Icon><PathIcon Data="{StaticResource IconLock}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  <MenuItem Header="_Unlock size" Command="{Binding ArrangeCommand}" CommandParameter="UnlockSize" />
                  <MenuItem Header="Lock _position" Command="{Binding ArrangeCommand}" CommandParameter="LockPosition"><MenuItem.Icon><PathIcon Data="{StaticResource IconPin}" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Unlock p_osition" Command="{Binding ArrangeCommand}" CommandParameter="UnlockPosition" />
                  <Separator />
                  <MenuItem Header="Select _all" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
                  </ContextMenu>
                </controls:LabelCanvas.ContextMenu>
              </controls:LabelCanvas>
            </ScrollViewer>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource SplitterBrush}" />

      <!-- Right: properties + outline -->
      <Grid Grid.Column="4" RowDefinitions="*,4,200" Margin="6,4">
        <ScrollViewer Grid.Row="0">
          <ContentControl Content="{Binding ActiveDocument.Properties, FallbackValue={x:Null}}" Margin="0,0,8,0" />
        </ScrollViewer>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
        <DockPanel Grid.Row="2">
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Entries" />
          <ListBox ItemsSource="{Binding ActiveDocument.Entries, FallbackValue={x:Null}}" SelectedItem="{Binding ActiveDocument.SelectedListItem, FallbackValue={x:Null}}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:EntryListItem">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Position}" Foreground="{DynamicResource MutedForeground}" Margin="6,0,0,0" />
                  <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
