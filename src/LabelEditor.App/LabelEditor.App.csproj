<Project Sdk="Microsoft.NET.Sdk">
  <!-- Composition root and Avalonia views. The only project that knows every layer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LabelEditor.App</RootNamespace>
    <AssemblyName>LabelEditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Views bind to instance members; generated code is not documented. -->
    <NoWarn>$(NoWarn);CA1822;CA1515;CA1812</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LabelEditor.Presentation\LabelEditor.Presentation.csproj" />
    <ProjectReference Include="..\LabelEditor.Infrastructure\LabelEditor.Infrastructure.csproj" />
    <ProjectReference Include="..\LabelEditor.Rendering\LabelEditor.Rendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LabelEditor.App.Tests" />
  </ItemGroup>
</Project>
