<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="11.3.23" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.23" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.23" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <!-- Hosting / composition -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="9.0.23" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
